# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Exemplo: postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Supabase API Credentials (opcional para uso do SDK do Supabase e Autenticação)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_NAME="aurum_financeiro_bot"
TELEGRAM_WEBHOOK_SECRET="ssua_chave_secreta_webhook"

# Gemini AI (Opcional - habilita transcrição de áudios e OCR de fotos de comprovantes no Telegram)
GEMINI_API_KEY="s"

# Cron Secret (Opcional - segurança para disparos de lembretes automáticos)
CRON_SECRET="seu_token_de_cron"
